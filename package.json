{
  "name": "antigravity-swarm-plaza",
  "version": "1.2.0",
  "description": "2.5D Isometric Pixel-Art Multi-Agent Skyscraper Dashboard & Antigravity IDE Sidecar Extension",
  "keywords": [
    "antigravity",
    "google-antigravity",
    "ai-agents",
    "multi-agent",
    "pixel-art",
    "isometric",
    "dashboard",
    "gamification",
    "gemini"
  ],
  "homepage": "https://github.com/akinba/antigravity-swarm-plaza#readme",
  "bugs": {
    "url": "https://github.com/akinba/antigravity-swarm-plaza/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akinba/antigravity-swarm-plaza.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "type": "module",
  "bin": {
    "antigravity-swarm-plaza": "./dist/cli.js"
  },
  "files": [
    "dist",
    "plugin",
    "README.md",
    "README.tr.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "dev": "concurrently \"npm.cmd run dev:server\" \"npm.cmd run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/bundle-sidecar.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "start": "node dist/cli.js --no-open",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/server/*.test.ts tests/client/*.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
